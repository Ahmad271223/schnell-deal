# Kopieren nach infra/env/production.env und Werte ersetzen. Diese Datei NIE mit echten Geheimnissen einchecken.
NODE_ENV=production
LOG_LEVEL=info
PORT=4000

# Domains (Caddy holt automatisch TLS-Zertifikate)
SITE_ADDRESS=auktion.example.de
STORAGE_ADDRESS=storage.auktion.example.de

DATABASE_URL=postgres://schnelldeal:schnelldeal@postgres:5432/schnelldeal
DATABASE_POOL_MAX=20
# Zeitlimits (ms): Warten auf eine Verbindung bzw. je Abfrage; hängende Verbindungen brechen mit Fehler ab statt still zu warten.
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=60000

ALLOWED_ORIGINS=https://auktion.example.de
PUBLIC_WEB_URL=https://auktion.example.de
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Object Storage: MinIO aus der Compose-Datei ODER Cloudflare R2 / S3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.auktion.example.de
S3_REGION=eu-central-1
S3_BUCKET=schnelldeal-private
S3_ACCESS_KEY=ersetzen
S3_SECRET_KEY=ersetzen
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=25
# Motorvideo (Außendienst/Admin). Höchstens 100: clamd scannt Datenströme standardmäßig nur bis 100 MB.
MAX_VIDEO_UPLOAD_MB=100

# Virenscanner (empfohlen): clamd-Dienst ergänzen und Host setzen
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# KI-Bilderkennung (FIN vom Foto, Bildausschnitt-Prüfung): API-Schlüssel von console.anthropic.com eintragen. Leer = Funktion aus.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# Günstigeres Modell nur für die Prüfung „Fahrzeug vollständig im Bild“ (leer = ANTHROPIC_MODEL); Kosten siehe docs/12-kosten-und-betrieb.md
ANTHROPIC_MODEL_PHOTO_CHECK=
AI_PHOTO_CHECK=true

SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ersetzen
SMTP_PASS=ersetzen
MAIL_FROM=Schnell-Deal <no-reply@example.de>

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=1000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:betrieb@example.de

RETENTION_DAYS=90

# Produktion: Managed PostgreSQL mit Point-in-Time-Recovery verwenden (DATABASE_URL anpassen) und
# Objekt-Versionierung im Bucket aktivieren. Die tägliche pg_dump-Sicherung ergänzt PITR, ersetzt sie nicht.

# --- Backups (Dienst "backup") ---
# Kopie außer Haus per rclone: Remote "offsite" wird über Umgebungsvariablen konfiguriert (kein Config-File nötig).
# Beispiel S3-kompatibler Speicher (Hetzner Object Storage, Backblaze B2, Cloudflare R2, AWS S3):
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<endpoint>
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=ersetzen
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=ersetzen
#   # Objektspeicher (Fotos, Videos, PDFs) ebenfalls außer Haus: rclone-Remote "storage" auf den S3-Speicher der Plattform
# (RCLONE_CONFIG_STORAGE_TYPE=s3, _PROVIDER, _ACCESS_KEY_ID, _SECRET_ACCESS_KEY, _ENDPOINT) und STORAGE_REMOTE=storage:<bucket>.
STORAGE_REMOTE=
# Alarm bei Backup-Fehlern (Webhook, z. B. Slack, Teams oder ntfy); leer = nur Protokoll.
ALERT_WEBHOOK_URL=
OFFSITE_REMOTE=offsite:schnelldeal-backups
OFFSITE_REMOTE=
BASE_BACKUP_EVERY_DAYS=7
BASE_RETENTION=2
