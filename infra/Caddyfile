# Reverse-Proxy für staging/production (automatisches HTTPS via Let's Encrypt).
# SITE_ADDRESS=auktion.example.de. Der Objektspeicher (S3, R2, Hetzner Object Storage) ist extern und braucht hier
# keinen Eintrag; nur mit eingebautem MinIO wird infra/Caddyfile.minio verwendet (CADDYFILE in der .env).
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# API inkl. WebSocket (/api/v1/ws) – Caddy leitet Upgrades automatisch weiter
	handle /api/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
