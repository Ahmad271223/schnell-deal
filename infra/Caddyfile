# Reverse-Proxy für staging/production (automatisches HTTPS via Let's Encrypt).
# SITE_ADDRESS=auktion.example.de, STORAGE_ADDRESS=storage.example.de (nur bei MinIO statt R2/S3)
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# API inkl. WebSocket (/api/v1/ws) – Caddy leitet Upgrades automatisch weiter
	handle /api/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Optional: MinIO für signierte Download-URLs öffentlich erreichbar machen (S3_PUBLIC_ENDPOINT=https://{$STORAGE_ADDRESS})
{$STORAGE_ADDRESS:storage.localhost} {
	reverse_proxy minio:9000
}
