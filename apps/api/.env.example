# --- Umgebung ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Datenbank (docker compose: Port 55432) ---
DATABASE_URL=postgres://schnelldeal:schnelldeal@localhost:55432/schnelldeal
DATABASE_POOL_MAX=20
# Zeitlimits (ms): Warten auf eine Verbindung bzw. je Abfrage; hängende Verbindungen brechen mit Fehler ab statt still zu warten.
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=60000

# --- Sicherheit ---
# Kommagetrennte Liste erlaubter Origins (CSRF-/WebSocket-Schutz)
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# In staging/production zwingend true (HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
TRUST_PROXY=false

# --- Object Storage (MinIO lokal, Cloudflare R2/S3 in Produktion) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=schnelldeal-private
S3_ACCESS_KEY=schnelldeal
S3_SECRET_KEY=schnelldeal-secret
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=25
# Motorvideo (Außendienst/Admin). Höchstens 100: clamd scannt Datenströme standardmäßig nur bis 100 MB.
MAX_VIDEO_UPLOAD_MB=100

# Virenscanner (clamd). Leer = Dateityp-/Größenprüfung ohne Virenscan.
CLAMAV_HOST=
CLAMAV_PORT=3310
# KI-Bilderkennung (FIN vom Foto, Bildausschnitt-Prüfung): API-Schlüssel von console.anthropic.com eintragen. Leer = Funktion aus.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# Günstigeres Modell nur für die Prüfung „Fahrzeug vollständig im Bild“ (leer = ANTHROPIC_MODEL); Kosten siehe docs/12-kosten-und-betrieb.md
ANTHROPIC_MODEL_PHOTO_CHECK=
AI_PHOTO_CHECK=true

# --- E-Mail (Mailpit lokal: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Schnell-Deal <no-reply@schnell-deal.local>

# --- Worker/Scheduler ---
# inline = Worker im API-Prozess, separate = eigener Prozess (pnpm --filter @sd/api worker)
WORKER_MODE=inline
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=1000

# --- Web-Push (optional). Schlüssel erzeugen: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@schnell-deal.local

# --- Seed (nur lokale Entwicklung; eigene Werte setzen!) ---
SEED_ADMIN_EMAIL=admin@schnell-deal.local
# Nur für die lokale Entwicklung; in staging/production lehnt der Seed diese bekannten Beispielwerte ab.
SEED_ADMIN_PASSWORD=Admin-Lokal-2026
SEED_DEMO_PASSWORD=Demo-Lokal-2026
