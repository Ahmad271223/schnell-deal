{
  "name": "@sd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate-cli.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "loadtest": "tsx src/scripts/loadtest.ts",
    "db:seed:demo": "tsx src/scripts/seed.ts --demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@sd/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "undici": "^8.11.2",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
